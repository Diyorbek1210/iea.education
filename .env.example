# Copy to `.env` and fill in. Never commit the filled-in file.
#
# Rule of thumb: anything a `VITE_` prefix makes visible to the browser is
# public. Only identifiers belong there — never a key that grants access.

# ---------------------------------------------------------------- public
# Firebase web config. These ship in the client bundle by design; they are only
# meaningful together with the Firestore rules in firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Which address is allowed into /admin. An address is a label, not a
# credential; the password is never in the codebase and never in this file.
# Must match `adminEmail()` in firestore.rules.
VITE_ADMIN_EMAIL=

# ------------------------------------------------------------ server only
# Read inside server functions via process.env. Never prefix these with
# VITE_ — that would publish them to the browser.

# Firebase service account, used by the admin server functions (account
# deletion, admin verification, leaderboard aggregate).
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PROJECT_ID=

# Kept in sync with VITE_ADMIN_EMAIL for the server-side check.
ADMIN_EMAIL=

# Cloudflare R2 (S3-compatible) for resource and shadowing uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Third-party APIs.
GEMINI_API_KEY=
GOOGLE_TTS_API_KEY=
